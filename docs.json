{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "KiosAPI",
  "description": "KiosAPI developer documentation",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/kiosapi.png",
    "dark": "/logo/kiosapi.png"
  },
  "navbar": {
    "links": [
      { "label": "Models & Pricing", "href": "https://kiosapi.com/pricing" },
      { "label": "GitHub", "href": "https://github.com/kiosapi" }
    ],
    "primary": {
      "type": "button",
      "label": "Open Dashboard",
      "href": "https://kiosapi.com"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        { "anchor": "Dashboard", "href": "https://kiosapi.com", "icon": "gauge" },
        { "anchor": "Models & Pricing", "href": "https://kiosapi.com/pricing", "icon": "credit-card" },
        { "anchor": "GitHub", "href": "https://github.com/kiosapi", "icon": "github" }
      ]
    },
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Quick Start",
